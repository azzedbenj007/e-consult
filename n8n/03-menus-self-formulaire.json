    {
      "id": "196d4659-b2f2-4f5b-8dbd-6117693b7c27",
      "name": "Préparer les lignes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const f = $('Formulaire équipe du self').first().json;\nconst jours = ['Lundi','Mardi','Mercredi','Jeudi','Vendredi'];\nconst start = new Date(f['Semaine du (lundi)']);\nconst theme = f['Thème (facultatif)'] || '';\nconst rows = jours.map((j, i) => {\n  const d = new Date(start); d.setDate(d.getDate() + i);\n  const [main, veggie, starter, dessert] = String(f[`${j} — plat`] || '').split(';').map(s => s.trim());\n  const th = theme.toLowerCase().startsWith(j.toLowerCase()) ? theme.split('=').pop().trim() : null;\n  return { day: d.toISOString().slice(0,10), main, veggie: veggie || null, starter: starter || null, dessert: dessert || null, theme: th };\n});\nreturn [{ json: { supabase_url: $('Config').first().json.supabase_url, rows } }];"
      }
    },
    {
      "id": "54989379-d3cf-46fd-b761-bbb7624b1280",
      "name": "Publier dans Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.supabase_url }}/rest/v1/menus",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "on_conflict",
              "value": "day"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Supabase service key (header apikey)"
        }
      }
    }
