# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql://econsult:changeme_strong_password@localhost:5432/econsult

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:changeme_redis_password@localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-key-min-32-chars-change-this-in-prod
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-chars-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Email (SendGrid) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_sendgrid_api_key
MAIL_FROM=noreply@e-consult.ma

# ─── TURN Server (Coturn) ─────────────────────────────────────────────────────
TURN_SERVER_URL=turn:turn.e-consult.ma:3478
TURN_USERNAME=econsult
TURN_PASSWORD=secure_turn_password_here
NEXT_PUBLIC_TURN_URL=turn:turn.e-consult.ma:3478
NEXT_PUBLIC_TURN_USERNAME=econsult
NEXT_PUBLIC_TURN_PASSWORD=secure_turn_password_here

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_KEY=pk_test_your_stripe_publishable_key
