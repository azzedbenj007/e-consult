# NOVA-EQP Backend Configuration

# Application
APP_NAME=NOVA-EQP
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Database
DATABASE_URL=postgresql+asyncpg://nova:password@db:5432/nova_eqp
DATABASE_URL_SYNC=postgresql://nova:password@db:5432/nova_eqp

# Redis
REDIS_URL=redis://redis:6379/0

# JWT Auth
JWT_SECRET=change-me-jwt-secret-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Providers
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
MISTRAL_API_KEY=your-mistral-key
PRIMARY_LLM=openai/gpt-4.1
SECONDARY_LLM=anthropic/claude-opus-4-6
FALLBACK_ENABLED=true

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=nova_documents

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT=60/minute
